    "@fontsource/chewy": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/stylish": "5.3.1",
    "@huggingface/transformers": "3.8.1",
    "@hyperframes/core": "0.8.222",
    "@hyperframes/player": "0.8.222",
    "@hyperframes/shader-transitions": "0.8.222",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "1eurofilter": "1.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.37.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.0",
    "tone": "15.1.22",
    "zustand": "^5.0.7",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "^1.54.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "hyperframes": "0.8.222",
    "prettier": "^3.9.10",
