{
  "name": "homeward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node tools/content_warn.mjs && tsc -b && vite build && node tools/build_offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:facts": "node tools/content_warn.mjs && node tools/accuracy_report.mjs",
    "predev": "node tools/fetch_mediapipe.mjs",
    "prebuild": "node tools/fetch_mediapipe.mjs",
    "gestures:check": "node tools/gestures_check.ts",
    "cutscene:build": "node scripts/cutscene.mjs build",
    "cutscene:lint": "node scripts/cutscene.mjs lint",
    "cutscene:snapshot": "node scripts/cutscene.mjs snapshot",
    "cutscene:preview": "node scripts/cutscene.mjs preview",
    "cutscene:render": "node scripts/cutscene.mjs render",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:web": "vite --host 127.0.0.1",
    "server": "python -m uvicorn server.app:app --host 127.0.0.1 --port 8000 --no-access-log",
    "nova:test": "python -m pytest server/tests -q",
    "nova:voices": "python -I scripts/nova_voices.py",
    "nova:cast": "python -I scripts/nova_voices.py --cast"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
