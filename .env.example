# Copy to server/.env (never commit .env). Only the local server reads these; nothing here reaches the browser.
# Gemini API key for Nova's online answers and voice (optional: without it Nova answers from the fact sheet).
GEMINI_API_KEY=
# Optional overrides (ids verified with client.models.list(), Nov 2026)
# NOVA_MODEL=gemini-3.5-flash-lite
# NOVA_TTS_MODEL=gemini-3.8-flash-tts
# Gemini TTS for live answers (needs TTS quota; the free tier allows 10 a day)
# NOVA_GEMINI_TTS=1
