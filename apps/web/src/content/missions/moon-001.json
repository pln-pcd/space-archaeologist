      "lines": [
        {
          "kind": "fact",
          "text": "Apollo 11 landed at Tranquility Base in 1969.",
          "sourceId": "F30"
        }
      ]
    },
    {
      "id": "first-step",
      "cameraRef": "first-step",
      "lines": [
        {
          "kind": "fact",
          "text": "Neil Armstrong and Buzz Aldrin explored the Moon.",
          "sourceId": "F30"
        }
      ]
    },
    {
      "id": "hop",
      "cameraRef": "hop",
      "lines": [
        {
          "kind": "fact",
          "text": "The Moon's gravity is about one sixth of Earth's.",
          "sourceId": "F19"
        }
      ]
    },
    {
      "id": "bootprint",
      "cameraRef": "bootprint",
      "lines": [
        {
          "kind": "fact",
          "text": "No wind blows the astronauts' footprints away.",
