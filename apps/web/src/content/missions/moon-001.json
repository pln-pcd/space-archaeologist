          "text": "Michael Collins stayed in lunar orbit aboard Columbia.",
          "sourceId": "F30"
        }
      ]
    },
    {
      "id": "flag-rocks",
      "cameraRef": "flag-rocks",
      "lines": [
        {
          "kind": "fact",
          "text": "Apollo 11 brought Moon rocks and soil home.",
          "sourceId": "F31"
        }
      ]
    },
    {
      "id": "experiments",
